# 复制本文件为 .env，填好你的密钥后直接运行：
#   Windows:       .\start.ps1
#   macOS / Linux: ./start.sh
#
# 安全提示：.env 已被 .gitignore 屏蔽，绝不会被提交到 Git。

# 【必填】DeepSeek API Key（用于伴读问答、提炼卡片、专题写作与联网搜索）
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 【推荐】阿里云百炼 / DashScope API Key（用于语义向量检索、图片识字、语音转文字；暂不填也可启动）
# 申请地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# 【可选】模型与接口地址（默认使用 DeepSeek，兼容任何 OpenAI 风格接口）
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com

# 【可选】你的文章与笔记存放目录（默认 ./data/vault，也可改成你现有的 Obsidian 目录）
VAULT_PATH=./data/vault

# 【留空自动生成】本地服务随机口令：首次运行启动脚本时会自动生成并写回本文件
HERMES_API_TOKEN=
